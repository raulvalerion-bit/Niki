# ── IA (SIEMPRE en env var, nunca hardcodeado — ver docs/sistema/30-INTEGRACION-IA.md) ─────
AI_MODEL=claude-sonnet-5                # modelo de visión del Check (30)
ANTHROPIC_API_KEY=                    # SOLO servidor — jamás NEXT_PUBLIC_
ANTHROPIC_WORKSPACE_ID=               # solo si la clave no está asignada a un espacio de trabajo (no es secreto)
AI_DAILY_BUDGET_USD=5                 # tope diario de gasto en IA (kill-switch)
AI_MONTHLY_BUDGET_USD=50              # tope mensual (≈10x el diario)

# ── Supabase (nomenclatura nueva, ver docs/sistema/51-STACK-PINEADO.md §5) ──────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx   # pública por diseño (RLS la protege)
SUPABASE_URL=https://xxxx.supabase.co                      # la misma URL, para el lado servidor
SUPABASE_SECRET_KEY=sb_secret_xxxx                         # SOLO servidor (equivale a service_role)

# ── Email transaccional (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=                       # SOLO servidor
EMAIL_FROM=hola@tudominio.com         # dominio propio verificado en Resend

# ── Venta (Hotmart) ──────────────────────────────────────────────────────────────────────────
HOTMART_HOTTOK=                       # verifica la firma del webhook — SOLO servidor
HOTMART_CLIENT_ID=                    # SOLO servidor — API de Hotmart (Herramientas → Credenciales), reconciliación semanal
HOTMART_CLIENT_SECRET=                # SOLO servidor — idem; el "Basic" se calcula del id+secret

# ── Tareas programadas (Vercel Cron) ─────────────────────────────────────────────────────────
CRON_SECRET=                          # SOLO servidor — autoriza /api/cron/*
